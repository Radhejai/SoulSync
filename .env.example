# --- Server ---
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase (get from your Supabase project settings) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- JWT ---
JWT_ACCESS_SECRET=change_me_generate_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_generate_a_different_long_random_string
JWT_REFRESH_EXPIRY=7d

# --- OTP provider (stubbed for now — see auth/otp.service.ts) ---
OTP_PROVIDER=stub
OTP_API_KEY=
OTP_SENDER_ID=

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=20
